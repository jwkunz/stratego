{
  "name": "stratego-server",
  "version": "2.1.0",
  "private": true,
  "description": "LAN multiplayer server for Stratego",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "start": "npm run build && node src/index.js",
    "serve": "node src/index.js",
    "test": "node --test test/*.test.js",
    "build:android": "vite build --config vite.android.config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
